{
  "name": "@culgate/nestjs",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS module for CulGate (pre-release).",
  "license": "MIT",
  "author": "culture007 (cultureHike)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@culgate/sdk": "workspace:^",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@culgate/core": "workspace:^",
    "@culgate/sdk": "workspace:^",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.4.2",
    "@types/express": "^5.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
