{
  "name": "culgate",
  "private": true,
  "type": "module",
  "description": "One interface. Multiple payment gateways.",
  "license": "MIT",
  "author": "culture007 (cultureHike)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && turbo run build typecheck test",
    "changeset": "changeset",
    "test:consumer": "node scripts/consumer-test.mjs",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
